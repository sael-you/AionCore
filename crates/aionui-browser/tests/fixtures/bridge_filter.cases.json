  "sanitize": [
    {
      "name": "requestWillBeSentExtraInfo associatedCookies and Cookie header",
      "frame": {
        "method": "Network.requestWillBeSentExtraInfo",
        "sessionId": "S",
        "params": {
          "requestId": "1",
          "associatedCookies": [
            {
              "cookie": {
                "name": "sid",
                "value": "secret-session",
                "httpOnly": true
              },
              "blockedReasons": []
            }
          ],
          "headers": {
            ":path": "/",
            "Cookie": "sid=secret-session",
            "Accept": "*/*"
          }
        }
      },
      "expect": {
        "method": "Network.requestWillBeSentExtraInfo",
        "sessionId": "S",
        "params": {
          "requestId": "1",
          "headers": {
            ":path": "/",
            "Accept": "*/*"
          }
        }
      }
    },
    {
      "name": "responseReceivedExtraInfo Set-Cookie, blockedCookies, headersText",
      "frame": {
        "method": "Network.responseReceivedExtraInfo",
        "params": {
          "requestId": "1",
          "blockedCookies": [
            {
              "cookieLine": "sid=secret-session"
            }
          ],
          "exemptedCookies": [],
          "headers": {
            "set-cookie": "sid=secret-session; HttpOnly",
            "Content-Type": "text/html"
          },
          "headersText": "HTTP/1.1 200\r\nSet-Cookie: sid=secret-session\r\n",
          "statusCode": 200
        }
      },
      "expect": {
        "method": "Network.responseReceivedExtraInfo",
        "params": {
          "requestId": "1",
          "headers": {
            "Content-Type": "text/html"
          },
          "statusCode": 200
        }
      }
    },
    {
      "name": "requestWillBeSent request headers",
      "frame": {
        "method": "Network.requestWillBeSent",
        "params": {
          "requestId": "1",
          "request": {
            "url": "https://a.b/",
            "method": "GET",
            "headers": {
              "COOKIE": "sid=secret-session",
              "User-Agent": "x"
            }
          }
        }
      },
      "expect": {
        "method": "Network.requestWillBeSent",
        "params": {
          "requestId": "1",
          "request": {
            "url": "https://a.b/",
            "method": "GET",
            "headers": {
              "User-Agent": "x"
            }
          }
        }
      }
    },
    {
      "name": "responseReceived response headers and requestHeaders",
      "frame": {
        "method": "Network.responseReceived",
        "params": {
          "requestId": "1",
          "response": {
            "url": "https://a.b/",
            "status": 200,
            "headers": {
              "Set-Cookie": "sid=secret-session"
            },
            "requestHeaders": {
              "Cookie": "sid=secret-session",
              "Accept": "*/*"
            },
            "requestHeadersText": "GET / HTTP/1.1\r\nCookie: sid=secret-session\r\n"
          }
        }
      },
      "expect": {
        "method": "Network.responseReceived",
        "params": {
          "requestId": "1",
          "response": {
            "url": "https://a.b/",
            "status": 200,
            "headers": {},
            "requestHeaders": {
              "Accept": "*/*"
            }
          }
        }
      }
    },
    {
